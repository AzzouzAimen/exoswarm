{
  "schema_version": "1",
  "suite_id": "exoswarm-harness-adversarial-v1",
  "global": {
    "mandatory_tests": ["signal_quality", "odd_even", "secondary_eclipse", "contamination"],
    "forbidden_persisted_terms": ["catalog_payload", "known_period", "raw_flux", "raw_lightcurve", "provider_body", "secret-cached-source", "system_prompt", "user_prompt", "messages", "tic_id", "toi_id"],
    "max_context_bytes": 16000,
    "require_contiguous_trace": true,
    "require_state_trace_consistency": true,
    "require_ground_truth_locked": true
  },
  "cases": {
    "clean_planet_like": {"status": "READY_TO_LOCK", "terminal_reason_contains": "CRITIC_VETO", "critic_verdicts": ["VETO"], "adaptive_tools": [], "failure_kinds": []},
    "eclipsing_binary_adverse": {"status": "READY_TO_LOCK", "disposition": "PLANETARY_INTERPRETATION_REJECTED", "critic_verdicts": ["APPROVE"], "adaptive_tools": ["harmonic_test"], "failure_kinds": []},
    "ambiguous_inconclusive": {"status": "INSUFFICIENT_EVIDENCE", "terminal_reason_contains": "INSUFFICIENT_EVIDENCE", "critic_verdicts": ["APPROVE"], "adaptive_tools": ["alternate_detrend"], "failure_kinds": ["INSUFFICIENT_EVIDENCE"]},
    "evidence_branch_contamination": {"status": "READY_TO_LOCK", "disposition": "PLANETARY_INTERPRETATION_REJECTED", "critic_verdicts": ["REVISE"], "adaptive_tools": ["centroid_localization"], "failure_kinds": []},
    "irrelevant_valid_action": {"status": "READY_TO_LOCK", "terminal_reason_contains": "CRITIC_VETO", "critic_verdicts": ["VETO"], "adaptive_tools": [], "failure_kinds": []},
    "malformed_primary_valid_repair": {"status": "READY_TO_LOCK", "attempt_statuses": ["INVALID", "SUCCESS", "SUCCESS"], "attempt_kinds": ["primary", "repair", "primary"], "adaptive_tools": ["harmonic_test"], "failure_kinds": []},
    "malformed_primary_repair_failure": {"status": "FAILED", "attempt_statuses": ["INVALID", "INVALID"], "attempt_kinds": ["primary", "repair"], "adaptive_tools": [], "failure_kinds": ["INVALID_MODEL_OUTPUT"]},
    "provider_timeout_explicit_fallback": {"status": "READY_TO_LOCK", "fallback_labels": ["AGENT_FALLBACK"], "attempt_statuses": ["TIMEOUT", "SUCCESS", "SUCCESS"], "adaptive_tools": ["harmonic_test"], "failure_kinds": []},
    "stale_context_mismatched_decision": {"status": "FAILED", "attempt_statuses": ["INVALID", "INVALID"], "adaptive_tools": [], "failure_kinds": ["INVALID_MODEL_OUTPUT"]},
    "unaffordable_action": {"status": "READY_TO_LOCK", "terminal_reason_contains": "NO_AFFORDABLE_VALID_ADAPTIVE_EXPERIMENT", "model_calls": 0, "adaptive_tools": [], "failure_kinds": []},
    "repeated_action": {"status": "FAILED", "adaptive_tools": [], "failure_kinds": ["REPEATED_ACTION"]},
    "tool_failure": {"status": "FAILED", "adaptive_tools": ["harmonic_test"], "failure_kinds": ["TOOL_INFRASTRUCTURE_FAILURE"]},
    "tool_timeout": {"status": "FAILED", "adaptive_tools": ["harmonic_test"], "failure_kinds": ["TOOL_TIMEOUT"]},
    "restart_prepared_action": {"status": "READY_TO_LOCK", "adaptive_tools": ["harmonic_test"], "recovery_events": 1, "failure_kinds": []},
    "context_pressure_trimming": {"status": "INSUFFICIENT_EVIDENCE", "recent_evidence_max": 6, "adaptive_tools": ["harmonic_test"], "failure_kinds": ["INSUFFICIENT_EVIDENCE"]},
    "runner_no_progress": {"status": "FAILED", "runner_stop_reason": "NO_DURABLE_PROGRESS", "failure_kinds": ["TOOL_INFRASTRUCTURE_FAILURE"]},
    "budget_step_exit": {"status": "BUDGET_EXHAUSTED", "failure_kinds": ["BUDGET_EXHAUSTED"]},
    "budget_model_exit": {"status": "BUDGET_EXHAUSTED", "model_calls": 0, "failure_kinds": ["BUDGET_EXHAUSTED"]},
    "budget_tool_exit": {"status": "BUDGET_EXHAUSTED", "adaptive_tools": [], "failure_kinds": ["BUDGET_EXHAUSTED"]},
    "budget_adaptive_exit": {"status": "READY_TO_LOCK", "terminal_reason_contains": "ADAPTIVE_EXPERIMENT_COUNT_BUDGET_REACHED", "model_calls": 0, "adaptive_tools": [], "failure_kinds": []},
    "budget_cost_exit": {"status": "READY_TO_LOCK", "terminal_reason_contains": "ADAPTIVE_COST_BUDGET_EXHAUSTED", "model_calls": 0, "adaptive_tools": [], "failure_kinds": []},
    "budget_critic_revision_exit": {"status": "BUDGET_EXHAUSTED", "critic_verdicts": [], "adaptive_tools": [], "failure_kinds": ["BUDGET_EXHAUSTED"]},
    "budget_runner_advance_exit": {"status": "FAILED", "runner_stop_reason": "ADVANCE_BUDGET_EXHAUSTED", "failure_kinds": ["TOOL_INFRASTRUCTURE_FAILURE"]},
