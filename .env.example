EXOSWARM_INFERENCE_TIMEOUT_SECONDS=30
EXOSWARM_INFERENCE_MAX_OUTPUT_TOKENS=900
EXOSWARM_AGENT_FALLBACK_ENABLED=false
EXOSWARM_RUNS_DIR=./runs
